# -------------------------------- #
# APP CONFIG
# -------------------------------- #
APP_ENV=(development|production)
APP_PORT=3000

# -------------------------------- #
# DATABASE CONFIG
# -------------------------------- #
DB_HOST=localhost
DB_USER=db_user
DB_PASS=db_pass
DB_NAME=db_name
DB_PORT=3306

# -------------------------------- #
# SMTP SERVICE
# -------------------------------- #
SMTP_HOST=smtp_host
SMTP_USER=smtp_user
SMTP_PASS=smtp_pass
# {true OR false}
SMTP_SECURE=true
# 465 (SSL/TLS) OR 587 (STARTTLS)
SMTP_PORT=465

# -------------------------------- #
# TOTP CONFIG
# -------------------------------- #
# TOTP Period dalam detik. Cth: 300 = 5 menit
TOTP_PERIOD=300

# -------------------------------- #
# JWT CONFIG
# -------------------------------- #
# Gunakan random bytes dari node:crypto dengan panjang 64-Bytes dan diencode menjadi HEX
JWT_SECRET="HEX(64_BYTES)"
# Masa aktif token JWT dalam detik, cth: 3600 = 1 jam
JWT_TTL_SECONDS=3600

# -------------------------------- #
# SITE CONFIG
# -------------------------------- #
SITE_TITLE=".:: Sistem Daftar Hadir Rapat Online ::."