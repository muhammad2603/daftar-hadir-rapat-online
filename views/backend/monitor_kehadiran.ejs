<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>.:: <%= title %> ::.</title>
    <link rel="stylesheet" href="/css/base.css">
</head>

<body class="h-dvh bg-blue-50 flex flex-col">
    <%- include('./layouts/partials/header.ejs') %>
    <div class="flex flex-1 min-h-0">
        <%- include('./layouts/partials/nav.ejs') %>
        <main class="flex-1 min-w-0 overflow-y-auto p-6 pb-24 md:pb-6 scrollbar-thin scrollbar-thumb-slate-400">
            <div class="mb-8">
                <h2 class="text-lg font-bold text-slate-800">Monitor Kehadiran</h2>
                <span class="text-sm text-gray-400 mt-0.5">Pantau kehadiran peserta disesi rapat yang sedang berlangsung</span>
            </div>
            <div class="space-y-2">
                <div class="bg-white border border-amber-200 rounded-2xl p-5 shadow-sm ring-1 ring-amber-50">
                    <div class="flex items-start justify-between flex-col-reverse lg:flex-row gap-4">
                        <div class="flex-1 min-w-0 mt-3 lg:mt-0">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse shrink-0"></span>
                                <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Berlangsung</span>
                            </div>
                            <h3 class="font-display font-bold text-gray-900">Rapat Koordinasi Triwulan</h3>
                            <p class="text-sm text-gray-500 mt-0.5 line-clamp-1">Evaluasi program kerja, penyusunan rencana anggaran, dan koordinasi pelaksanaan kegiatan antar instansi.</p>
                            <div class="mt-3 flex flex-wrap gap-4 text-xs text-gray-400">
                                <span class="inline-flex items-center gap-1.5 max-[437px]:shrink-0 max-[437px]:grow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        class="lucide lucide-calendar-1 preview-icon size-4.5">
                                        <path d="M11 13h1v4" />
                                        <path d="M16 2v3" />
                                        <path d="M3 9h18" />
                                        <path d="M8 2v3" />
                                        <rect x="3" y="3" width="18" height="18" rx="2" />
                                    </svg>
                                    <time datetime="2026-09-22">22 September 2026</time>
                                </span>
                                <span class="inline-flex items-center gap-1.5 max-[437px]:shrink-0 max-[437px]:grow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        class="lucide lucide-map-pin preview-icon size-4.5">
                                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                                        <circle cx="12" cy="10" r="3" />
                                    </svg>
                                    <span>Ruang CoC</span>
                                </span>
                                <span class="inline-flex items-center gap-2 max-[437px]:shrink-0 max-[437px]:grow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        class="lucide lucide-clock preview-icon size-4.5">
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M12 6v6l4 2" />
                                    </svg>
                                    <span>Dimulai 11:30</span>
                                </span>
                            </div>
                        </div>
                        <div class="w-full flex lg:block lg:w-fit items-center justify-between shrink-0 text-right">
                            <div>
                                <p class="text-center text-3xl font-bold text-navy-900 tracking-wider">28</p>
                                <p class="font-semibold text-xs text-gray-400 text-center">Peserta Hadir</p>
                            </div>
                            <a href="/monitor-kehadiran/{rapat-identity}" class="mt-3 flex items-center gap-2 px-4 py-2 bg-blue-900 text-white text-sm font-semibold rounded-xl hover:bg-navy-800 transition hover:bg-blue-hover">
                                <span>Lihat Daftar Peserta</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="lucide lucide-chevron-right preview-icon size-4">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>

</html>