<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>.:: <%= title %> ::.</title>
    <link rel="stylesheet" href="/css/base.css">
</head>

<body class="h-dvh bg-blue-50 flex flex-col print:bg-white">
    <%- include('./layouts/partials/header.ejs') %>
    <div class="flex flex-1 min-h-0">
        <%- include('./layouts/partials/nav.ejs') %>
        <main class="flex-1 min-w-0 overflow-y-auto p-6 pb-24 md:pb-6 scrollbar-thin scrollbar-thumb-slate-400">
            <div class="space-y-4 mb-16">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                        <a href="/dashboard/monitor-kehadiran" class="flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition mb-4 print:hidden">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-arrow-left preview-icon size-4">
                                <path d="m12 19-7-7 7-7" />
                                <path d="M19 12H5" />
                            </svg>
                            <span>Kembali ke Monitor Kehadiran</span>
                        </a>
                        <h2 class="font-display text-2xl font-bold text-gray-900"><%= meetingData.judul %></h2>
                        <div class="flex flex-wrap gap-x-4 mt-1 text-xs text-gray-400 print:mt-3 print:text-base print:text-black/75">
                            <span class="inline-flex gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="lucide lucide-calendar-1 preview-icon size-3 print:size-4.5">
                                    <path d="M11 13h1v4" />
                                    <path d="M16 2v3" />
                                    <path d="M3 9h18" />
                                    <path d="M8 2v3" />
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                </svg>
                                <span><%= meetingData.tanggal %></span>
                            </span>
                            <span class="inline-flex gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="lucide lucide-map-pin preview-icon size-3 print:size-4.5">
                                    <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                                <span><%= meetingData.ruang %></span>
                            </span>
                            <span class="inline-flex gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="lucide lucide-user-round preview-icon size-3 print:size-4.5">
                                    <circle cx="12" cy="8" r="5" />
                                    <path d="M20 21a8 8 0 0 0-16 0" />
                                </svg>
                                <span><%= meetingData.pimpinan_rapat %></span>
                            </span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 shrink-0 print:hidden">
                        <button id="btnShowQrCode" type="button" class="flex items-center gap-1.5 px-3 py-2 border border-blue-900/20 text-blue-900 text-xs font-medium rounded-xl hover:bg-blue-50 transition cursor-pointer disabled:cursor-not-allowed disabled:opacity-60" <%= (meetingData.state !== "Sedang Berlangsung") ? "disabled" : "" %>>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="size-4">
                                <circle cx="18" cy="5" r="3" />
                                <circle cx="6" cy="12" r="3" />
                                <circle cx="18" cy="19" r="3" />
                                <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
                                <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />
                            </svg>
                            <span>Bagikan</span>
                        </button>
                        <button id="btnEndSession" data-meeting-id="<%= meetingData.id %>" type="button" class="flex items-center gap-1.5 px-3 py-2 bg-red-50 text-red-600 text-xs font-semibold border border-solid border-red-300 rounded-xl cursor-pointer transition-colors duration-150 ease-in hover:not-disabled:bg-red-100 hover:not-disabled:border-red-400 disabled:opacity-60 disabled:cursor-not-allowed" <%= (meetingData.state !== "Sedang Berlangsung") ? "disabled" : "" %>>Akhiri Sesi</button>
                    </div>
                </div>
                <% if(meetingData.state === "Sedang Berlangsung") { %>
                    <div class="flex items-center justify-between px-4 py-3 rounded-xl border bg-amber-50 border-amber-200 print:hidden">
                        <div class="flex items-center gap-2">
                            <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                            <span class="text-sm font-semibold text-amber-700">Sesi sedang berlangsung — absensi terbuka</span>
                        </div>
                        <span class="text-xs text-gray-400">Auto-refresh setiap 3 detik</span>
                    </div>
                <% } else { %>
                    <div class="flex items-center justify-between px-4 py-3 rounded-xl border bg-gray-50 border-gray-200 print:hidden">
                        <div class="flex items-center gap-2">
                            <span class="size-2 rounded-full bg-gray-500"></span>
                            <span class="text-sm font-semibold text-gray-500">Sesi telah berakhir, tidak dapat memantau kehadiran secara berkala.</span>
                        </div>
                    </div>
                <% } %>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden print:mt-12 print:shadow-none print:border-gray-200 print:rounded-none">
                    <div class="px-6 py-4 border-b border-gray-50 flex items-center justify-between print:hidden">
                        <h3 class="font-semibold text-gray-800">Daftar Peserta Hadir</h3>
                        <span class="text-xs text-gray-400 bg-gray-50 border border-gray-100 px-3 py-1 rounded-full font-semibold"><%= totalParticipants %> Peserta</span>
                    </div>
                    <div class="p-6 print:py-3.5 print:px-2">
                        <% if(totalParticipants > 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead class="text-gray-400 print:text-black">
                                        <tr class="border-b border-gray-100 print:border-gray-200">
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider w-10 print:hidden">No
                                            </th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider">Nama Pegawai</th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider">Jabatan</th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider">OPD</th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider">Nomor HP</th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider">Tanda Tangan</th>
                                            <th class="text-left py-2.5 px-3 text-xs font-semibold  uppercase tracking-wider print:hidden">Waktu
                                                Hadir</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-50">
                                        <% listParticipants.forEach((row, idx) => { %>
                                            <tr class="hover:bg-gray-50/50 transition-colors group">
                                                <td class="py-3 px-3 text-gray-400 text-sm print:hidden print:text-black/75"><%= ++idx %></td>
                                                <td class="py-3 px-3">
                                                    <p class="participant-name font-medium text-gray-600 text-sm print:text-black/75"><%= row.nama_pegawai %></p>
                                                </td>
                                                <td class="py-3 px-3 text-gray-600 text-sm leading-snug max-w-40 print:text-black/75"><%= row.jabatan %></td>
                                                <td class="py-3 px-3 text-gray-600 text-sm print:text-black/75"><%= row.nama_opd %></td>
                                                <td class="py-3 px-3 text-gray-600 text-sm tracking-wider print:text-black/75"><%= row.nomor_hp %></td>
                                                <td class="py-3 px-3">
                                                    <!-- TODO Source tanda tangan peserta harus diambil melalui endpoint -->
                                                    <img src="https://i.pinimg.com/736x/f0/a9/93/f0a993fdc4e1d81651f1d820c746fc3f.jpg"
                                                        alt="Tanda Tangan <%= row.nama_pegawai %>" title="Klik untuk melihat full view"
                                                        class="ttd-image h-10 w-24 object-contain border border-gray-100 rounded bg-white cursor-pointer print:border-none" />
                                                </td>
                                                <td class="time-presence py-3 px-3 text-gray-500 text-sm print:hidden"><%= row.waktu_kehadiran %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="text-center py-16 text-gray-400 hidden">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="lucide lucide-users-round preview-icon size-16 mx-auto mb-3 opacity-30">
                                    <path d="M18 21a8 8 0 0 0-16 0" />
                                    <circle cx="10" cy="8" r="5" />
                                    <path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3" />
                                </svg>
                                <p class="text-sm font-medium">Belum Ada Peserta yang Hadir</p>
                                <p class="text-xs mt-1">Bagikan tautan absensi kepada peserta rapat</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="bottom-fingerprint-attendance px-14 flex justify-end-safe gap-14">
                <div id="configurationsPanel" class="box-fingerprint-inputs w-150 h-fit bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4 print:hidden">
                    <div class="grid grid-cols-2 gap-2.5">
                        <input type="text"
                            id="placeName"
                            placeholder="Nama Tempat"
                            class="w-full h-fit border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" />
                        <div>
                            <input type="date"
                                id="datePublish"
                                class="w-full h-fit mb-1 border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" />
                            <label for="sameAsMeetingDate" class="text-xs cursor-pointer">
                                <input type="checkbox" id="sameAsMeetingDate" class="ml-1 align-middle" />
                                <span>Samakan dengan tanggal rapat</span>
                            </label>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2.5">
                        <input type="text"
                            id="personChargeName"
                            placeholder="Nama Penanggung Jawab"
                            class="input-config w-full h-fit mb-1 border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors [&.invalid]:border-red-400" />
                        <input type="text"
                            id="personChargePosition"
                            placeholder="Jabatan Penanggung Jawab"
                            class="input-config w-full h-fit border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors [&.invalid]:border-red-400" />
                    </div>
                    <div class="grid grid-cols-2 gap-2.5">
                        <input type="text"
                            id="personChargeRank"
                            placeholder="Pangkat Penanggung Jawab"
                            class="input-config w-full h-fit border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors [&.invalid]:border-red-400" />
                        <input type="text"
                            id="personChargeIdNumber"
                            placeholder="NIP Penanggung Jawab"
                            class="input-config w-full h-fit mb-1 border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors [&.invalid]:border-red-400" />
                    </div>
                    <p class="w-fit text-xs text-amber-500">Catatan: Informasi penanggung jawab hanya dapat disimpan sebanyak 8 konfigurasi.</p>
                    <div class="grid grid-cols-2 gap-2.5">
                        <button type="button" id="saveAsConfig" class="bg-blue-900 hover:bg-blue-hover disabled:opacity-60 text-xs text-white font-semibold py-2.5 rounded-xl transition-colors shadow-md cursor-pointer">Simpan Informasi Penanggung Jawab</button>
                        <button type="button" id="closeConfigurationsPanel" class="bg-blue-900 hover:bg-blue-hover disabled:opacity-60 text-xs text-white font-semibold py-2.5 rounded-xl transition-colors shadow-md cursor-pointer">Selesai</button>
                    </div>
                </div>
                <div id="savedConfigPanel"
                    class="box-fingerprint-inputs hidden w-fit h-fit bg-white rounded-2xl border border-slate-200 shadow-sm p-4 space-y-4 print:hidden">
                    <select
                        id="configSelect"
                        class="w-full border border-slate-200 rounded-lg p-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors">
                        <option value="#">Pilih Konfigurasi Tersimpan:</option>
                        <option value="JSON STRING">Boni Bonanza, S.Kom - Kepala Bidang TIK</option>
                    </select>
                    <div class="flex justify-end">
                        <button type="button" id="closeSavedConfigPanel"
                            class="py-2.5 px-8 bg-blue-900 hover:bg-blue-hover disabled:opacity-60 text-xs text-white font-semibold rounded-xl transition-colors shadow-md cursor-pointer">Selesai</button>
                    </div>
                </div>
                <div class="box-fingerprint w-65 text-left relative">
                    <div class="icon-config absolute top-0 right-full mr-3 space-y-3 print:hidden">
                        <button type="button" id="openConfig" class="transition duration-100 hover:rotate-90 cursor-pointer group" title="Buka Konfigurasi">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-settings preview-icon text-slate-500 hover:text-slate-700">
                                <path
                                    d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                        <button type="button" id="openSavedConfig" class="transition duration-100 cursor-pointer group" title="Konfigurasi Tersimpan">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-bookmark-check preview-icon text-slate-500 group-hover:text-slate-700">
                                <path
                                    d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z" />
                                <path d="m9 10 2 2 4-4" />
                            </svg>
                        </button>
                    </div>
                    <div class="top">
                        <p><span data-input-id="placeName">...</span>, <span data-input-id="datePublish" data-meeting-date="<%= meetingData.tanggal %>">...</span></p>
                        <p>Mengetahui,</p>
                        <p><span data-input-id="personChargePosition">...</span>,</p>
                    </div>
                    <div class="ttd-box mt-3 w-full relative border-2 border-dashed border-slate-300 rounded-lg print:border-transparent">
                        <div id="resetTtd" class="hidden absolute -top-2.5 right-1.5 justify-end mt-4 print:hidden">
                            <button class="py-1 px-2.5 border border-solid border-red-300 text-[11px] rounded-md bg-red-50 text-red-600 cursor-pointer transition-colors duration-150 ease-in hover:bg-red-100 hover:border-red-400">Ulangi Tanda Tangan</button>
                        </div>
                        <span id="ttdText" class="signature-area absolute top-1/2 left-1/2 -translate-1/2 font-semibold text-sm text-slate-400 print:hidden">(TTD Disini)</span>
                        <canvas id="signaturePad" class="w-full h-32 cursor-pen-tool block touch-none!"></canvas>
                        <p class="absolute w-full bottom-0"><b data-input-id="personChargeName">...</b></p>
                    </div>
                    <div class="bottom">
                        <p><span data-input-id="personChargeRank">...</span></p>
                        <p>NIP <span data-input-id="personChargeIdNumber">...</span></p>
                    </div>
                </div>
            </div>
        </main>
        <div id="qrCode" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm print:hidden">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                    <div>
                        <h2 class="font-display text-lg font-bold text-gray-900">Bagikan Tautan Absensi</h2>
                        <p class="text-xs text-gray-400 mt-0.5 truncate max-w-70"><%= meetingData.judul %></p>
                    </div>
                    <button id="btnCloseQrCode" title="Tutup" class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 cursor-pointer hover:bg-gray-100 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-x preview-icon size-5">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </div>
                <div class="p-6 space-y-5">
                    <div class="flex flex-col items-center">
                        <div class="p-3 border-2 border-gray-100 rounded-2xl bg-white">
                            <img src="/api/meetings/qr-presence/<%= meetingData.slug_kehadiran %>"
                                alt="QR Code"
                                width="200"
                                height="200"
                                class="rounded-lg">
                        </div>
                        <p class="text-xs text-gray-400 mt-2">Scan QR Code untuk membuka form absensi</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex-1 h-px bg-gray-200"></div>
                        <span class="text-xs text-gray-400 font-medium">atau bagikan tautan</span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="flex-1 min-w-0 px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-600 font-mono truncate"><%= link_kehadiran %></div>
                        <button type="button" id="copyLink" data-link="<%= link_kehadiran %>" class="shrink-0 px-4 py-2.5 rounded-xl text-sm font-semibold transition bg-blue-900 text-white cursor-copy hover:not-disabled:bg-blue-hover disabled:opacity-40">Salin</button>
                    </div>
                    <p class="text-xs text-amber-600 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2">Catatan: Tautan ini hanya aktif selama sesi rapat berlangsung.</p>
                </div>
            </div>
        </div>
        <div id="popUpTtdImage" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm print:hidden">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                    <div>
                        <h2 class="font-display text-lg font-bold text-gray-900">Tanda Tangan Peserta</h2>
                        <p class="text-xs text-gray-400 mt-0.5 truncate max-w-70">Nama Peserta: <span id="participantName"></span></p>
                    </div>
                    <button
                        id="btnCloseTtdImage"
                        title="Tutup"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 cursor-pointer hover:bg-gray-100 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-x preview-icon size-5">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </div>
                <div class="p-6 space-y-5">
                    <div class="flex flex-col items-center">
                        <div class="p-3 border-2 border-gray-100 rounded-2xl bg-white">
                            <img src=""
                                width="200" height="200" class="rounded-lg">
                        </div>
                        <p class="font-semibold text-sm text-gray-400 mt-4.5">Waktu Hadir: <span id="timePresence"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/copy-link.js"></script>
    <script type="module" src="/js/pages/live_view_kehadiran.js"></script>
    <!-- <script type="module" src="/js/signature-pad.js"></script> -->
</body>

</html>