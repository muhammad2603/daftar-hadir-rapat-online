<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="X-CSRF-TOKEN" content="<%= csrfToken %>" />
    <meta name="SESSION-ID" content="<%= meetingData.id %>" />
    <title>.:: <%= title %> ::.</title>
    <link rel="stylesheet" href="/css/base.css">
</head>

<body class="h-dvh bg-blue-50 flex flex-col">
    <%- include('./layouts/partials/header.ejs') %>
    <div class="flex flex-1 min-h-0">
        <%- include('./layouts/partials/nav.ejs') %>
        <main class="flex-1 min-w-0 overflow-y-auto p-6 pb-24 md:pb-6 scrollbar-thin scrollbar-thumb-slate-400">
            <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-md overflow-y-auto">
                <div class="header-form px-6 py-5 border-b border-slate-100">
                    <h1 class="font-bold text-lg text-slate-800 mb-1.5">Edit Sesi Rapat</h1>
                    <p class="text-xs text-slate-600">Mengedit: <span class="font-semibold mr-1.5">#<%= meetingData.id %></span>•<span class="font-semibold ml-1.5"><%= meetingData.judul %></span></p>
                </div>
                <div class="form-body px-6 py-5 space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 gap-3">
                        <div>
                            <label for="judulRapat"
                                class="block text-xs font-medium text-slate-600 mb-1.5">Judul Rapat <span
                                    class="font-semibold text-red-500">*</span></label>
                            <input type="text" placeholder="Masukkan Judul Rapat..." id="judulRapat"
                                value="<%= meetingData.judul %>"
                                autocomplete="off"
                                class="w-full border border-slate-200 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors">
                        </div>
                        <div>
                            <label for="tanggalRapat"
                                class="block text-xs font-medium text-slate-600 mb-1.5">Tanggal Rapat <span
                                    class="font-semibold text-red-500">*</span></label>
                            <input type="date" id="tanggalRapat"
                                value="<%= meetingData.tanggal %>"
                                class="w-full border border-slate-200 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors">
                        </div>
                    </div>
                    <div>
                        <label for="ruangRapat"
                            class="inline-block text-xs font-medium text-slate-600 mb-1.5">Lokasi / Ruang <span
                                class="font-semibold text-red-500">*</span></label>
                        <input type="text" placeholder="Masukkan Lokasi / Ruang Rapat..." id="ruangRapat"
                            value="<%= meetingData.ruang %>"
                            autocomplete="off"
                            class="w-full border border-slate-200 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors">
                    </div>
                    <div>
                        <label for="agendaRapat"
                            class="inline-block text-xs font-medium text-slate-600 mb-1.5">Agenda Rapat</label>
                        <textarea id="agendaRapat" rows="4" placeholder="Masukkan Topik yang Akan Dibahas..."
                            class="w-full border border-slate-200 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors resize-none"><%= meetingData.agenda %></textarea>
                    </div>
                    <div class="flex gap-3 pt-2">
                        <a
                            href="/dashboard/sesi-rapat/kelola"
                            id="backPage"
                            class="flex-1 border border-slate-200 text-slate-600 font-semibold text-center py-2.5 rounded-xl text-sm transition-colors hover:bg-slate-50 [&.disabled]:opacity-60">Batalkan</a>
                        <button
                            id="editSesiRapat"
                            type="button"
                            class="flex-1 flex justify-center items-center gap-1.5 bg-blue-900 text-white font-semibold py-2.5 rounded-xl text-sm transition-colors cursor-pointer hover:not-disabled:bg-blue-hover disabled:opacity-40 disabled:cursor-not-allowed">Perbarui</button>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/pages/edit_sesi_rapat.js"></script>
</body>

</html>