<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>.:: <%= title %> ::.</title>
    <link rel="stylesheet" href="/css/base.css">
</head>

<body class="h-dvh bg-blue-50 flex flex-col">
    <%- include('./layouts/partials/header.ejs') %>
    <div class="flex flex-1 min-h-0">
        <%- include('./layouts/partials/nav.ejs') %>
        <main class="flex-1 min-w-0 overflow-y-auto p-6 pb-24 md:pb-6 scrollbar-thin scrollbar-thumb-slate-400">
            <div class="mb-8">
                <h2 class="text-lg font-bold text-slate-800">Pengaturan</h2>
                <span class="text-sm text-gray-400 mt-0.5">Lihat informasi akun anda dan pengaturan administrator lainnya</span>
            </div>
            <div class="space-y-5">
                <div class="bg-white rounded-2xl border border-gray-100 p-6 space-y-4">
                    <div>
                        <h3 class="font-semibold text-gray-800 mb-1">Kop Surat Instansi (Default)</h3>
                        <p class="text-sm text-gray-400 mb-4">Unggah kop surat resmi instansi Anda sebagai kop default. Gambar akan
                            ditampilkan di bagian atas formulir absensi peserta.</p>
                        <div>
                            <div class="kop-surat-upload">
                                <input type="file" accept="image/*" class="hidden" id="kopSuratDefault" hidden>
                                <label for="kopSuratDefault" id="dropFileZone" class="block border-2 border-dashed rounded-2xl p-8 text-center cursor-pointer transition-all border-gray-200 hover:border-blue-700/70 hover:bg-gray-50">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        class="lucide lucide-image-plus preview-icon size-10 mx-auto text-gray-300 mb-3 pointer-events-none">
                                        <path d="M16 5h6" />
                                        <path d="M19 2v6" />
                                        <path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" />
                                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                                        <circle cx="9" cy="9" r="2" />
                                    </svg>
                                    <p class="text-sm font-medium text-gray-600 pointer-events-none">Klik atau seret gambar kop surat ke sini</p>
                                    <p class="text-xs text-gray-400 mt-1 pointer-events-none">PNG, JPG, hingga 5MB. Disarankan rasio 4:1.</p>
                                </label>
                            </div>
                            <div id="previewKopSurat" class="w-fit mx-auto hidden">
                                <img id="previewImg" alt="Kop Surat Default"
                                    class="w-full h-40 aspect-4/1 object-contain border border-slate-200 rounded-lg p-2 bg-slate-50">
                                <div class="btn-kop-surat-actions flex justify-end gap-3">
                                    <button type="button"
                                        id="hapusKopSurat"
                                        class="flex justify-center items-center gap-2 mt-4 py-1 px-2 border border-solid border-red-300 text-sm rounded-md bg-red-50 text-red-600 cursor-pointer transition-colors duration-150 ease-in hover:bg-red-100 hover:border-red-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                            class="lucide lucide-file-minus preview-icon size-3">
                                            <path
                                                d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
                                            <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                                            <path d="M9 15h6" />
                                        </svg>
                                        <span>Hapus Kop Surat</span>
                                    </button>
                                    <button type="button"
                                        id="submitKopSurat"
                                        class="flex justify-center items-center gap-2 mt-4 py-1 px-2 border border-solid text-sm rounded-md bg-blue-900 text-white cursor-pointer transition-colors duration-150 ease-in hover:bg-blue-hover">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                            class="lucide lucide-file-pen preview-icon size-3">
                                            <path
                                                d="M12.659 22H18a2 2 0 0 0 2-2V8a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 14 2H6a2 2 0 0 0-2 2v9.34" />
                                            <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                                            <path
                                                d="M10.378 12.622a1 1 0 0 1 3 3.003L8.36 20.637a2 2 0 0 1-.854.506l-2.867.837a.5.5 0 0 1-.62-.62l.836-2.869a2 2 0 0 1 .506-.853z" />
                                        </svg>
                                        <span>Perbarui Kop Surat</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
                    <div class="bg-white rounded-2xl border border-gray-100 p-6">
                        <h3 class="font-semibold text-gray-800 mb-4">Informasi Akun</h3>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-400">Username</span>
                                <span class="font-semibold text-gray-800">fattahillah</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-400">Email</span>
                                <span class="font-mono text-xs text-gray-600">(Email belum ditambahkan)</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-400">Role</span>
                                <span class="font-semibold text-xs text-blue-900 uppercase tracking-wider">Super Admin</span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 p-6">
                        <div class="flex justify-between items-center gap-1.5 mb-4">
                            <h3 class="font-semibold text-gray-800">Daftar User</h3>
                            <a href="/dashboard/pengaturan/daftar-user" class="py-0.5 px-2 text-xs border border-solid border-blue-300 bg-blue-50 text-blue-600 rounded-sm transition-colors hover:bg-blue-100 hover:border-blue-400">Semua User</a>
                        </div>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-gray-800">fattahillah (Anda)</span>
                                <span class="font-semibold text-xs text-blue-900 uppercase tracking-wider">Super Admin</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-gray-800">susan</span>
                                <span class="font-semibold text-xs text-blue-900 uppercase tracking-wider">Admin</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-gray-800">hanypulh</span>
                                <span class="font-semibold text-xs text-blue-900 uppercase tracking-wider">Admin</span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 p-6">
                        <h3 class="font-semibold text-gray-800 mb-4">Keamanan Akun</h3>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-400">Two Factor Authentication (2FA)</span>
                                <a href="/auth/two-factor-auth-activation" class="py-0.5 px-2 text-xs border border-solid border-blue-300 bg-blue-50 text-blue-600 rounded-sm transition-colors hover:bg-blue-100 hover:border-blue-400">Aktifkan</a>
                                <!-- <span class="py-0.5 px-2 text-xs border border-solid border-gray-300 bg-gray-50 text-gray-600 rounded-sm select-none">Sudah Aktif</span> -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <!-- Pop Up informasi untuk kegagalan aktivasi Two Factor Authentication -->
    <div class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                <div>
                    <h2 class="font-display text-lg font-bold text-gray-900">Aktivasi Gagal</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Two Factor Authentication tidak dapat diaktifkan</p>
                </div>
            </div>
            <div class="py-5 px-6 text-sm text-gray-400">
                <p class="font-medium">Pastikan Email telah ditambahkan pada akun anda.</p>
            </div>
            <div class="p-3 flex justify-end gap-3">
                <button type="button"
                    class="border border-slate-200 text-slate-600 font-semibold py-2.5 px-6 rounded-xl text-sm transition-colors cursor-pointer hover:bg-slate-50">Tutup</button>
            </div>
        </div>
    </div>
    <script src="/js/drag-n-drop.js"></script>
</body>

</html>