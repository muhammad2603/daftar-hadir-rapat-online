<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>.:: Dashboard ::.</title>
    <link rel="stylesheet" href="/css/base.css">
</head>
<body class="h-dvh bg-blue-50 flex flex-col">
    <header class="bg-blue-900 text-white px-6 h-16 flex items-center justify-between shrink-0 shadow-md">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-book-user preview-icon size-5">
                    <path d="M15 13a3 3 0 1 0-6 0" />
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20" />
                    <circle cx="12" cy="8" r="2" />
                </svg>
            </div>
            <div>
                <h1 class="font-display text-base font-bold leading-tight">Daftar Hadir Rapat Online</h1>
                <p class="text-white/40 text-[12px] leading-tight">Panel Administrator</p>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="hidden sm:block text-right">
                <p class="text-sm font-semibold text-white leading-tight">fattahillah</p>
                <p class="text-white/40 text-[12px] leading-tight">Super Admin</p>
            </div>
            <a href="/logout" class="text-white/50 hover:text-white transition text-xs border border-white/20 rounded-lg px-3 py-1.5 hover:bg-white/10">Keluar</a>
        </div>
    </header>
    <div class="flex flex-1 min-h-0">
        <nav class="w-56 bg-white border-r border-gray-200 shrink-0 overflow-y-auto py-4 hidden md:flex flex-col">
            <div class="px-3 space-y-0.5 flex-1">
                <a href="/dashboard" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all bg-blue-900 text-white shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard preview-icon size-5">
                        <rect width="7" height="9" x="3" y="3" rx="1" />
                        <rect width="7" height="5" x="14" y="3" rx="1" />
                        <rect width="7" height="9" x="14" y="12" rx="1" />
                        <rect width="7" height="5" x="3" y="16" rx="1" />
                    </svg>
                    <span>Dashboard</span>
                </a>
                <a href="/dashboard/sesi-rapat/kelola"
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-file-pen preview-icon size-5">
                        <path
                            d="M12.659 22H18a2 2 0 0 0 2-2V8a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 14 2H6a2 2 0 0 0-2 2v9.34" />
                        <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                        <path
                            d="M10.378 12.622a1 1 0 0 1 3 3.003L8.36 20.637a2 2 0 0 1-.854.506l-2.867.837a.5.5 0 0 1-.62-.62l.836-2.869a2 2 0 0 1 .506-.853z" />
                    </svg>
                    <span>Kelola Sesi Rapat</span>
                </a>
                <a href="/dashboard/monitor-kehadiran" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-check preview-icon size-5">
                        <path d="M16 5H3" />
                        <path d="M16 12H3" />
                        <path d="M11 19H3" />
                        <path d="m15 18 2 2 4-4" />
                    </svg>
                    <span>Monitor Kehadiran</span>
                </a>
                <a href="/dashboard/sesi-rapat/riwayat"
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-list preview-icon size-5">
                        <path d="M3 5h.01" />
                        <path d="M3 12h.01" />
                        <path d="M3 19h.01" />
                        <path d="M8 5h13" />
                        <path d="M8 12h13" />
                        <path d="M8 19h13" />
                    </svg>
                    <span>Riwayat Sesi Rapat</span>
                </a>
                <a href="/dashboard/sesi-rapat/bagikan-tautan" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-qr-code preview-icon size-5">
                        <rect width="5" height="5" x="3" y="3" rx="1" />
                        <rect width="5" height="5" x="16" y="3" rx="1" />
                        <rect width="5" height="5" x="3" y="16" rx="1" />
                        <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
                        <path d="M21 21v.01" />
                        <path d="M12 7v3a2 2 0 0 1-2 2H7" />
                        <path d="M3 12h.01" />
                        <path d="M12 3h.01" />
                        <path d="M12 16v.01" />
                        <path d="M16 12h1" />
                        <path d="M21 12v.01" />
                        <path d="M12 21v-1" />
                    </svg>
                    <span>Bagikan Tautan</span>
                </a>
                <a href="/dashboard/pengaturan"
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all text-gray-600 hover:bg-gray-50 hover:text-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-settings preview-icon size-5">
                        <path
                            d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <span>Pengaturan</span>
                </a>
            </div>
        </nav>
        <main class="flex-1 min-w-0 overflow-y-auto p-6 pb-24 md:pb-6 scrollbar-thin scrollbar-thumb-slate-400">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-xl border p-4 border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="py-2 px-2.5 bg-blue-50 text-blue-600 rounded-lg border border-solid border-blue-600/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-chart-no-axes-column preview-icon size-4">
                                <path d="M5 21v-6" />
                                <path d="M12 21V3" />
                                <path d="M19 21V9" />
                            </svg>
                        </span>
                    </div>
                    <p class="text-2xl font-bold text-slate-800">1</p>
                    <p class="text-xs text-slate-500 mt-0.5">Total Sesi</p>
                </div>
                <div class="bg-white rounded-xl border p-4 border-amber-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="py-2 px-2.5 bg-amber-50 text-amber-600 rounded-lg border border-solid border-amber-600/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-list-clock preview-icon size-4">
                                <path d="M16 13v2.2l1.6 1" />
                                <path d="M3 12h3.458" />
                                <path d="M3 19h3.832" />
                                <path d="M3 5h18" />
                                <circle cx="16" cy="15" r="6" />
                            </svg>
                        </span>
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    </div>
                    <p class="text-2xl font-bold text-amber-700">1</p>
                    <p class="text-xs text-slate-500 mt-0.5">Sesi Sedang Berlangsung</p>
                </div>
                <div class="bg-white rounded-xl border p-4 border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="py-2 px-2.5 bg-green-50 text-green-600 rounded-lg border border-solid border-green-600/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-list-check preview-icon size-4">
                                <path d="M16 5H3" />
                                <path d="M16 12H3" />
                                <path d="M11 19H3" />
                                <path d="m15 18 2 2 4-4" />
                            </svg>
                        </span>
                    </div>
                    <p class="text-2xl font-bold text-slate-800">1</p>
                    <p class="text-xs text-slate-500 mt-0.5">Sesi Selesai</p>
                </div>
                <div class="bg-white rounded-xl border p-4 border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="py-2 px-2.5 bg-purple-50 text-purple-600 rounded-lg border border-solid border-purple-600/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-calendar-1 preview-icon size-4">
                                <path d="M11 13h1v4" />
                                <path d="M16 2v3" />
                                <path d="M3 9h18" />
                                <path d="M8 2v3" />
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                            </svg>
                        </span>
                    </div>
                    <p class="text-2xl font-bold text-slate-800">1</p>
                    <p class="text-xs text-slate-500 mt-0.5">Sesi Rapat Hari Ini</p>
                </div>
            </div>
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h2 class="text-lg font-bold text-slate-800">Sesi Rapat Hari Ini</h2>
                    <span class="text-sm text-gray-400 mt-0.5">Kelola dan pantau sesi rapat yang sedang berlangsung hari ini</span>
                </div>
                <button type="button" class="flex items-center gap-2 bg-blue-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer hover:bg-blue-hover">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-plus preview-icon size-5">
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                    </svg>
                    <span>Buat Sesi Rapat</span>
                </button>
            </div>
            <div class="space-y-3">
                <!-- __COMMENT__ Data ini hanya Sesi dengan state Sedang Berlangsung saja -->
                <div class="w-full flex bg-white rounded-xl border border-slate-200 hover:border-secondary hover:shadow-md p-5 text-left transition-all group">
                    <div class="flex-1 shrink-0">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                                <span class="size-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                <span>Sedang Berlangsung</span>
                            </span>
                        </div>
                        <h3 class="font-semibold text-slate-800 truncate group-hover:text-secondary transition-colors">Rapat Koordinasi Triwulan
                        </h3>
                        <p class="text-sm text-gray-500 line-clamp-2 mt-0.5">Evaluasi program kerja, penyusunan rencana anggaran, dan koordinasi
                            pelaksanaan kegiatan antar instansi.</p>
                        <p class="text-xs text-slate-500 mt-2.5">
                            <span><time datetime="2026-09-22">22 September 2026</time> • 11:30 • Ruang Command Control</span>
                        </p>
                    </div>
                    <div class="flex flex-col gap-4 mt-3 shrink-0 w-30">
                        <button
                            data-session-id="1"
                            class="flex justify-center items-center gap-2 py-2 px-2 border border-solid border-red-300 text-[11px] rounded-md bg-red-50 text-red-600 cursor-pointer transition-colors duration-150 ease-in hover:bg-red-100 hover:border-red-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-octagon-x preview-icon size-4">
                                <path d="m15 9-6 6" />
                                <path
                                    d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z" />
                                <path d="m9 9 6 6" />
                            </svg>
                            <span>Akhiri Sesi</span>
                        </button>
                        <a href="/dashboard/detail-rapat/{rapat-identity}"
                            class="flex justify-center items-center gap-2 py-2 px-2 border border-solid border-blue-300 text-[11px] rounded-md bg-blue-50 text-blue-600 cursor-pointer transition-colors duration-150 ease-in hover:bg-blue-100 hover:border-blue-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-scan-eye preview-icon size-4">
                                <path d="M3 7V5a2 2 0 0 1 2-2h2" />
                                <path d="M17 3h2a2 2 0 0 1 2 2v2" />
                                <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
                                <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
                                <circle cx="12" cy="12" r="1" />
                                <path d="M18.944 12.33a1 1 0 0 0 0-.66 7.5 7.5 0 0 0-13.888 0 1 1 0 0 0 0 .66 7.5 7.5 0 0 0 13.888 0" />
                            </svg>
                            <span>Detail</span>
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>